# v6 (Hindi): fully self-hosted — IndicConformer STT + Gemma-2-9B LLM (vLLM) + IndicF5 TTS.
# Copy to .env.local and fill in. .env.local and *.json are gitignored — keep secrets there.

# LiveKit Cloud credentials (from https://cloud.livekit.io) — WebRTC transport only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- STT: self-hosted AI4Bharat IndicConformer (OpenAI-compatible /v1/audio/transcriptions) ---
STT_BASE_URL=http://localhost:8001/v1
STT_MODEL=indic-conformer
STT_LANGUAGE=hi

# --- LLM: self-hosted Gemma-2-9B-it AWQ via vLLM (OpenAI-compatible) ---
# Served by docker compose profile `llm-local`; needs gemma_system.jinja chat template + HF_TOKEN.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=gemma2-9b

# --- TTS: self-hosted AI4Bharat IndicF5 (OpenAI-compatible /v1/audio/speech, sentence-streamed) ---
# Keep tts-1 so the LiveKit openai plugin streams raw PCM. Voice is a single cloned reference.
TTS_BASE_URL=http://localhost:8002/v1
TTS_MODEL=tts-1
# TTS pace/latency are set as env on the F5 server itself (tts_server.py), not here:
#   F5_SPEED (<1 = slower, ~0.67), F5_NFE (16 = faster synth), F5_EXPAND_ACRONYMS (1 = IIT->आई आई टी)

# Hugging Face token (gated models: IndicConformer, IndicF5, Gemma-2-9B-AWQ). Used as HF_TOKEN env
# when launching the model servers — not required by agent.py itself.
# HF_TOKEN=your_hf_token

# --- LEGACY (Phase 1 only; not used on the current hot path) ---
# Google service-account JSON authenticated Vertex Gemini + Cloud TTS before going fully local.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# GOOGLE_CLOUD_PROJECT=rhobots-playzone
# GOOGLE_CLOUD_LOCATION=asia-south1
