# Copy to .env and fill in. .env is gitignored (holds the shared secret).
# DOMAIN: a hostname that resolves to this VM's PUBLIC IP. With no real domain, use sslip.io:
#   for IP a.b.c.d ->  a-b-c-d.sslip.io   (e.g. 35-240-243-226.sslip.io)
DOMAIN=35-240-243-226.sslip.io
# Any key/secret pair. The agent and gen_token.py MUST use the same pair.
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
