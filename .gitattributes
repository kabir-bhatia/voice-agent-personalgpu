# Keep LF on everything that runs on the Linux VM (CRLF would break shell/systemd/python).
*.sh        text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.template  text eol=lf
*.service   text eol=lf
*.jinja     text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
Dockerfile  text eol=lf
*.wav       binary
